# ============================================================
# Ephemeral Archive — переменные окружения (пример)
# Скопируйте в .env.local: cp .env.example .env.local
# Ни одна переменная не обязательна: приложение работает «из коробки»,
# оба API (Hacker News, Wayback Machine) бесплатны и без ключей.
# ============================================================

# Публичный базовый URL для metadata/openGraph (например https://ephemeral-archive.vercel.app)
# NEXT_PUBLIC_SITE_URL=

# GitHub-репозиторий (используется в header/footer; по умолчанию захардкожен в компонентах)
# GITHUB_REPO_URL=https://github.com/ephemeral-archive/ephemeral-archive

# Количество новостей из топа HN (по умолчанию 30)
# HN_STORIES_LIMIT=30

# Интервал ISR-ревалидации в секундах (по умолчанию 3600 = 1 час)
# REVALIDATE_SECONDS=3600
